         "string",
         "null"
        ]
       },
       "saknas_steg": {
        "description": "Steget som skulle ge uppgiften, eller vad som saknas för att få den. null = inget saknas.",
        "type": [
         "string",
         "null"
        ]
       },
       "kalla_fil": {
        "description": "Fil, från repots rot, som utlåtandet bygger på. null = ingen.",
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "post",
       "status",
       "metod",
       "osakerhet",
       "saknas_steg",
       "kalla_fil"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "koordinater",
    "kameror",
    "personer",
    "rum",
    "masker",
    "korlogg",
    "kvalitet"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "schema_version",
  "revision",
  "klipp",
  "tidsbas",
  "semantik",
  "matning"
 ],
 "additionalProperties": false,
 "$defs": {
  "filref": {
   "description": "Pekare till en fil som ingest redan har skrivit. Sökvägen är relativ till mappen där kalla.json ligger.",
   "type": "object",
   "properties": {
    "sokvag": {
     "description": "Relativ sökväg, snedstreck framåt.",
     "type": "string",
     "minLength": 1
    },
    "sha256": {
     "description": "SHA-256 för filens innehåll, 64 hextecken. Ändras filen är pekaren inte längre giltig.",
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "format": {
     "description": "Filformat.",
     "type": "string",
     "enum": [
      "json",
      "npz",
      "npy",
      "mp4",
      "jpg",
      "png",
      "md",
      "log"
     ]
    },
    "roll": {
     "description": "Vad filen innehåller, en mening.",
     "type": "string"
    },
    "nycklar": {
     "description": "För npz/npy: arrayerna i filen med form, typ och enhet. Läst ur den verkliga filen, inte antagen.",
     "type": "array",
     "items": {
      "$ref": "#/$defs/nyckel"
     }
    }
   },
   "required": [
    "sokvag",
    "sha256",
    "format",
    "roll"
   ],
   "additionalProperties": false
  },
  "nyckel": {
   "description": "En array i en npz-fil.",
   "type": "object",
   "properties": {
    "namn": {
     "description": "Arrayens nyckel i filen.",
     "type": "string"
    },
    "form": {
     "description": "Arrayens form.",
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "dtype": {
     "description": "numpy-typ, till exempel float32 eller bool.",
     "type": "string"
    },
    "enhet": {
     "description": "Enhet om arrayen har en, annars null.",
     "type": [
      "string",
      "null"
     ]
    },
    "beskrivning": {
     "description": "Vad arrayen innehåller.",
     "type": "string"
    }
   },
   "required": [
    "namn",
    "form",
    "dtype",
